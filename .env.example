# ═══════════════════════════════════════════════════════════
# SERVER ONLY — never expose service_role to the browser / git
# Copy to .env and fill values.
# ═══════════════════════════════════════════════════════════

MRF_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
MRF_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only (register without email confirm). NEVER put in public/
MRF_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Telegram bot + Mini App (server-only token)
# Webhook: https://YOUR_DOMAIN/api/telegram?action=webhook
# Auto-sets on first «Привязать» or: node scripts/set-telegram-webhook.js
MRF_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
MRF_TELEGRAM_BOT_USERNAME=YourBotUsername
# Optional override for Bot API secret_token (default: derived from bot token)
# MRF_TELEGRAM_WEBHOOK_SECRET=random_long_secret_here
# Public site origin (return URLs, Mini App)
# MRF_PUBLIC_ORIGIN=https://mrf-murex.vercel.app
# Channel / support / premium visuals
MRF_TELEGRAM_CHANNEL_URL=https://t.me/cinusVkvadrate
MRF_TELEGRAM_SUPPORT_URL=https://t.me/NerdIdk
# Photo URL (jpg/png) for bot menu — optional
# MRF_TELEGRAM_MENU_PHOTO_URL=https://YOUR_CDN/mrf-menu.jpg
# Premium sticker file_id from Bot API (optional)
# MRF_TELEGRAM_STICKER_WELCOME=
# MRF_TELEGRAM_STICKER_OK=
# MRF_TELEGRAM_STICKER_FAIL=
# MRF_TELEGRAM_STICKER_PAY=
# Cron secret for /api/telegram?action=reminders (or reuse webhook secret)
# MRF_CRON_SECRET=random_long_secret_here

# YooKassa (Premium checkout) — shop id + secret from merchant cabinet
# Webhook URL in YooKassa: https://YOUR_DOMAIN/api/billing?action=webhook
# Events: payment.succeeded
MRF_YOOKASSA_SHOP_ID=your_shop_id
MRF_YOOKASSA_SECRET_KEY=your_secret_key
