# ═══════════════════════════════════════════════════════════
# SERVER ONLY — never expose service_role to the browser / git
# Copy to .env and fill values.
# ═══════════════════════════════════════════════════════════

MRF_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
MRF_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY

# Server-only (register without email confirm). NEVER put in public/
MRF_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Telegram Login Widget (BotFather → bot → domain for your site)
# Token stays server-only. Username is returned to the UI via /api/me?resource=telegram
MRF_TELEGRAM_BOT_TOKEN=123456:ABC-DEF
MRF_TELEGRAM_BOT_USERNAME=YourBotUsername
