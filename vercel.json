{
  "version": 2,
  "builds": [
    { "src": "api/auth.js", "use": "@vercel/node" },
    { "src": "api/me.js", "use": "@vercel/node" },
    { "src": "api/library.js", "use": "@vercel/node" },
    { "src": "api/recommendations.js", "use": "@vercel/node" },
    { "src": "api/billing.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/me", "dest": "/api/me.js" },
    { "src": "/api/library", "dest": "/api/library.js" },
    { "src": "/api/recommendations", "dest": "/api/recommendations.js" },
    { "src": "/api/billing", "dest": "/api/billing.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
